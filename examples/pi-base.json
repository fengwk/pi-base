{
  "defaultAgent": "jiji",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "edit": "ask",
    "write": "ask",
    "apply_patch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow"
    }
  },
  "render": {
    "collapsedToolResultLines": {
      "*": 10,
      "bash": 20
    },
    "collapsedToolResultMaxChars": {
      "*": 4000
    }
  },
  "subagent": {
    "maxDepth": 3,
    "maxConcurrency": 4,
    "maxTotalConcurrency": 8,
    "idleTimeoutMs": 120000,
    "maxTurns": 50
  }
}
